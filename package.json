{
  "name": "hinopt-restaurant-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Hinopt Restaurant POS - Offline-first restaurant POS with central licensing",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "start:api": "npm.cmd --prefix services/local-api run start",
    "dev:api": "npm.cmd --prefix services/local-api run dev",
    "build:api": "npm.cmd --prefix services/local-api run build",
    "test:api": "npm.cmd --prefix services/local-api run test",
    "lint:api": "npm.cmd --prefix services/local-api run lint",
    "migrate": "npm.cmd --prefix services/local-api run migrate",
    "seed": "npm.cmd --prefix services/local-api run seed",
    "license:generate-keys": "npm.cmd --prefix services/license-service run generate-keys",
    "license:issue": "npm.cmd --prefix services/license-service run issue",
    "license:verify": "npm.cmd --prefix services/license-service run verify",
    "license:test": "npm.cmd --prefix services/license-service run test",
    "license:build": "npm.cmd --prefix services/license-service run build",
    "test:all": "npm.cmd --prefix services/local-api run test && npm.cmd --prefix services/license-service run test",
    "start:admin": "node apps/hinopt_admin/server.js",
    "admin": "node apps/hinopt_admin/server.js",
    "provision": "node tools/provision-client.js"
  },
  "keywords": [
    "restaurant-pos",
    "offline-first",
    "point-of-sale",
    "kot",
    "thermal-printer"
  ],
  "author": "Hinopt",
  "license": "UNLICENSED"
}
