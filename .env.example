# ==============================================================================
# Hinopt Restaurant POS - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT SENSITIVE SECRETS OR PRIVATE KEYS TO VERSION CONTROL.

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Restaurant Identity
RESTAURANT_ID=rest_01h8x
RESTAURANT_NAME="Curry Leaf Fine Dining"

# Local Database Configuration (PostgreSQL on Counter PC)
# Store money in integer paise (e.g., 25000 = ₹250.00)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/curry_leaf_pos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=curry_leaf_pos
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_CONNECTIONS=20

# Device Authentication & Token Signing
# Generated unique random string for signing JWT tokens for authorized devices
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=30d

# Licensing (Asymmetric Ed25519 Public Key)
# The local server uses this public key to verify signed license payloads from Hinopt Cloud.
# NEVER place private signing keys on the Counter PC or client applications.
LICENSE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...replace_with_hinopt_cloud_public_key...\n-----END PUBLIC KEY-----"
LICENSE_VERIFICATION_INTERVAL_HOURS=24
LICENSE_OFFLINE_GRACE_DAYS=7

# Print Service Configuration
PRINT_SERVICE_PORT=4001
BILL_PRINTER_TYPE=network
BILL_PRINTER_TARGET=192.168.1.200:9100
BILL_PRINTER_PAPER_WIDTH=80mm
KOT_PRINTER_TYPE=network
KOT_PRINTER_TARGET=192.168.1.201:9100
KOT_PRINTER_PAPER_WIDTH=80mm

# Logging
LOG_LEVEL=info
