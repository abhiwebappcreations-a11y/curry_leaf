{
  "name": "@hinopt/local-api",
  "version": "1.0.0",
  "description": "Hinopt Restaurant POS - Local API & Backend Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
